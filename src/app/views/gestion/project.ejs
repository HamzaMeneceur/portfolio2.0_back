<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="/images/favicon.ico" />
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <link href="/css/reset.css" rel="stylesheet">
    <link href="/css/gestion-de-projet.css" rel="stylesheet">
    <script src="/js/project.js" defer></script>
    <title>Gestion des reseaux sociaux</title>
</head>
<% if(!project){ %>
<body class="no-project">
<% } else { %>
    <body>
      <% } %>
    <header>
        <div id="title-container-top">
            <div id="img-top">
                <img src="/images/favicon.ico" alt="Logo du portfolio" width="100px">
            </div>
            <nav id="nav-menu">
                <ol>
                    <li>Compte</li>
                    <li>Projets</li>
                    <li>Réseaux sociaux</li>
                    <li>Déconnexion</li>
                </ol>
            </nav>
        </div>
    </header>
    <% if(project) { %>
    <aside>
        <div class="info-prj">
<!--    Je veux afficher les information d'un élément
        Ciblée    -->
        
        <div class="project-selected">
            <div class="selected-title">
                <h1><%= project.name %></h1>
            </div>
            <div class="selected-link">
                <a href="<%= project.link %>"><%= project.link %></a>
            </div>
            <div class="selected-info">
                <p><%=project.project_date.toLocaleDateString("fr-FR") %></p>
                <p><%= project.type_of_project %></p>
    
            </div>
        </div>
        
        </div>
    </aside>
    <% } %>
    <main>
<!--    J'utilise les information en fonction des éléménts
        Ciblée    
        Ouverture d'une modal form-->
        <div class="btn-mod">
            <button class="btn-mod-in">
                Ajouter
            </button>
            <button class="btn-mod-in">
                Modifier
            </button>
            <button class="btn-mod-in">
                Supprimer
            </button>
        </div>
<!--    Liste dynamique de mes projets  -->
        <div class="list-prj">
            <% if(projects) { %>
                <% for(project of projects) { %>
                    <a class="prj-in" href="http://localhost:3001/v1/admin/s/project?projectSelected=<%= project.id  %>"><p><%= project.name %></p></a>                
                <% } } %>
        </div>

        <!-- modal add -->
         <div id="modal-add">
            <form action="/v1/admin/s/project/modal-add-post" method="post">
                <div>
                    <label for="name">Nom du projet</label>
                    <input type="text" name="name" id="name">
                </div>
                <div>
                    <label for="projectType">Quel est le type de projet ?</label>
                    <select name="projectType" id="type-select">
                        <option value="">Liste de projets</option>
                        <option value="Solo">Réaliser seul</option>
                        <option value="Professionnel">Réaliser pour un client</option>
                        <option value="Academique">En étude</option>
                    </select>
                </div>
                <div>
                    <label for="link">Le lien associé</label>
                    <input type="url" name="link" id="link" placeholder="https://example.com" pattern="https://.*" size="30">
                </div>
                <div>
                    <input type="submit" value="Entrer" id="-form-add-submit">
                </div>
            </form>
         </div>
        <!-- modal update -->
        <div id="modal-update">
            <form action="#" method="post">
                <div>
                    <label for="name">Nom du projet</label>
                    <input type="text" name="name" id="name">
                </div>
                <div>
                    <label for="type_of_project">Quel est le type de projet ?</label>
                    <select name="type_of_project" id="type-select">
                        <option value="">Liste de projets</option>
                        <option value="Solo">Réaliser seul</option>
                        <option value="Professionnel">Réaliser pour un client</option>
                        <option value="Academique">En étude</option>
                    </select>
                </div>
                <div>
                    <label for="link">Le lien associé</label>
                    <input type="url" name="link" id="link" placeholder="https://example.com" pattern="http://.*" size="30">
                </div>
                <div>
                    <input type="submit" value="Entrer" id="-form-update-submit">
                </div>              
            </form>
        </div>
        <!-- modal delete -->
        <div id="modal-delete">
            <form action="#" method="post">
                <div></div>
                <div></div>
                <div></div>
            </form>
        </div>

    </main>
    <%- include('../partials/footer') %>
