<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="/images/favicon.ico" />
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <link href="/css/reset.css" rel="stylesheet">
    <link href="/css/auth.css" rel="stylesheet">
    <title>Créer un compte administrateur</title>
</head>
<body>
    <header>
        <div id="title-container-top">
            <div id="img-top">
                <img src="/images/favicon.ico" alt="Logo du portfolio" width="100px">
            </div>
            <h1>Tableau de bord administrateur</h1>
        </div>
    </header>
    <main>
        <div id="form-content">
            <h2>Créer votre compte administrateur</h2>
            <form action="/v1/admin/s/signup-post" method="post">
                <div class="ca-input">  
                    <label for="email">Votre email</label>
                    <input type="email" name="email" id="email" placeholder="email@admin.com">
                </div>
                <div class="ca-input">
                    <label for="password">Mot de passe</label>
                    <input type="password" name="password" id="password" placeholder="******">
                </div>
                <div class="ca-input">
                    <label for="confirm">Confirmer mot de passe</label>
                    <input type="password" name="confirm" id="confirm" placeholder="******">
                </div>
                <div class="ca-input submit-e">
                    <input type="submit" value="Entrer" id="ca-submit">
                </div>
            </form>
            <%  if(msg) { %>
                <div class="alert-msg">
                    <p>
                <%= msg %>
            </p>
        </div>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer') %>
