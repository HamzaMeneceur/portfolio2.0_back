<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="/images/favicon.ico" />
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <link href="/css/reset.css" rel="stylesheet">
    <link href="/css/auth.css" rel="stylesheet">
    <title>Dashboard Administratif</title>
</head>
<body>
    <header>
        <div id="title-container-top">
            <div id="img-top">
                <img src="/images/favicon.ico" alt="Logo du portfolio" width="100px">
            </div>
            <h1>Bienvenue sur le Portail d'Administration</h1>
        </div>
    </header>

<main >

    <div id="form-content">
        <h2>Connecter Vous !</h2>
    
<form action="/v1/admin/s/signin-post" method="post">

    <div class="ca-input">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="email@admin.com">
    </div>
                <div class="ca-input">
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="password" placeholder="********">
            </div>
 <div class="ca-input">
    <input type="button" value="Mot de passe oublié ?" id="form-forget">

 </div>
    <% if(!limitReached) {%>
    <div id="btn-submit">
        <input type="submit" value="Entrer" id="form-submit">
    </div>
    <% }%>
</form>
<%  if(msg || limitReached) { %>
    <div class="alert-msg">
        <p>
    <%= msg %>
</p>
</div>
<% } %>
</div>
</main>
<%- include('../partials/footer') %>
